{title:"Andrew et Matteo",icon:"🎮",category:"Mini-jeux",html:"\u003c!doctype html>\n\u003chtml lang=\"fr\">\n\u003chead>\n\u003cmeta charset=\"utf-8\">\n\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\u003ctitle>Anddrew et Mathéo — Mini-jeux\u003c/title>\n\u003cstyle>\n:root{--bg:#0b1020;--panel:#151e35;--panel2:#202d4d;--text:#f4f7ff;--muted:#b0bdd8;--blue:#52b6ff;--purple:#a66bff;--green:#4ce0a1}\n*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#1c2d53,#0b1020 65%);font-family:system-ui,Arial,sans-serif;color:var(--text)}\nheader{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:16px max(4%,calc((100% - 1150px)/2));background:#0a1022ed;border-bottom:1px solid #29395d;position:sticky;top:0;z-index:5}\n.logo{font-weight:950;font-size:1.1rem}.logo b{color:var(--blue)}nav{display:flex;gap:8px;flex-wrap:wrap}\nbutton{font:inherit;cursor:pointer}.navbtn,.btn{border:1px solid #3b4d77;border-radius:11px;background:#1b2948;color:white;padding:10px 14px;font-weight:750}.navbtn:hover,.btn:hover{filter:brightness(1.2)}.btn.primary{border:0;background:linear-gradient(90deg,var(--blue),var(--purple))}.btn.green{background:#174a43;border-color:#2b8e7c}\nmain{max-width:1150px;margin:auto;padding:22px 16px 50px}.hero{display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:20px;padding:30px;border:1px solid #344873;border-radius:24px;background:linear-gradient(120deg,#1a2e52,#2c2051 75%,#123747);overflow:hidden}\n.kicker{color:#8fd2ff;text-transform:uppercase;font-size:.78rem;font-weight:850;letter-spacing:2px}.hero h1{font-size:clamp(2rem,5vw,3.7rem);line-height:1.04;margin:10px 0}.hero p{color:#d1dbf2;line-height:1.6}.hero-art{text-align:center;font-size:clamp(5rem,12vw,9rem);filter:drop-shadow(0 12px 18px #0008)}\nh2{font-size:1.45rem;margin:28px 0 14px}.muted{color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.card{background:linear-gradient(160deg,#182440,#111a30);border:1px solid #2d4068;border-radius:18px;overflow:hidden}.art{height:125px;display:grid;place-items:center;font-size:3.5rem;background:radial-gradient(circle at 35% 30%,#345b93,#171c40 72%)}.card:nth-child(3n+2) .art{background:radial-gradient(circle at 35% 30%,#7445a8,#171c40 72%)}.card:nth-child(3n) .art{background:radial-gradient(circle at 35% 30%,#24756b,#171c40 72%)}.cardbody{padding:14px}.card h3{margin:0 0 5px}.card p{color:var(--muted);font-size:.9rem;min-height:42px;margin:0 0 12px}.card .btn{width:100%}\n.page{display:none}.page.active{display:block}.panel{padding:20px;background:#131d34;border:1px solid #2b3d62;border-radius:18px}.avatar-wrap{display:flex;gap:25px;align-items:center;flex-wrap:wrap}.avatar{width:140px;height:190px;border:1px solid #3d507a;border-radius:18px;background:#0b1327;display:grid;place-items:center}.avatar svg{width:115px;height:160px}.options{display:flex;gap:9px;flex-wrap:wrap;margin:10px 0 16px}.swatch{width:38px;height:38px;border:3px solid #ffffff55;border-radius:11px}.swatch:focus{outline:3px solid white}.field{background:#0b1327;border:1px solid #40537b;border-radius:10px;color:white;padding:10px;max-width:100%}.gamebox{margin-top:18px;padding:18px;background:#121b31;border:1px solid #2a3d63;border-radius:18px}.gamebox canvas{display:block;width:min(100%,500px);height:auto;margin:12px auto;background:#081225;border-radius:12px;border:1px solid #35466b}.gamecontrols{display:flex;gap:9px;justify-content:center;flex-wrap:wrap}.message{min-height:24px;color:#bcd0f5;text-align:center}.footer{text-align:center;color:#8796b8;border-top:1px solid #243454;padding:25px 12px;margin-top:35px;font-size:.85rem}\n@media(max-width:760px){.hero{grid-template-columns:1fr}.hero-art{display:none}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}header{position:static}}\n@media(max-width:480px){.cards{grid-template-columns:1fr}.hero{padding:22px}.hero h1{font-size:2.2rem}.navbtn{padding:8px 10px}}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\u003cheader>\n \u003cdiv class=\"logo\">🎮 \u003cb>ANDDREW\u003c/b> ET MATHÉO\u003c/div>\n \u003cnav aria-label=\"Navigation\">\n  \u003cbutton class=\"navbtn\" data-page=\"home\">🏠 Lobby\u003c/button>\n  \u003cbutton class=\"navbtn\" data-page=\"skins\">👕 Mes skins\u003c/button>\n \u003c/nav>\n\u003c/header>\n\u003cmain>\n\u003csection class=\"page active\" id=\"home\">\n \u003cdiv class=\"hero\">\u003cdiv>\u003cdiv class=\"kicker\">Ton espace de jeu\u003c/div>\u003ch1>Bienvenue dans\u003cbr>\u003cspan style=\"color:#7dcaff\">ta Game Zone !\u003c/span>\u003c/h1>\u003cp>Choisis un mini-jeu, teste tes réflexes et personnalise ton avatar. Tout se joue en solo, directement dans ton navigateur.\u003c/p>\u003cbutton class=\"btn primary\" onclick=\"document.querySelector('#games').scrollIntoView({behavior:'smooth'})\">Découvrir les jeux ↓\u003c/button>\u003c/div>\u003cdiv class=\"hero-art\" aria-hidden=\"true\">🕹️ ✨\u003c/div>\u003c/div>\n \u003ch2 id=\"games\">🔥 Le lobby — choisis ton jeu\u003c/h2>\n \u003cdiv class=\"cards\">\n  \u003carticle class=\"card\">\u003cdiv class=\"art\">⚡\u003c/div>\u003cdiv class=\"cardbody\">\u003ch3>Neon Dodge\u003c/h3>\u003cp>Esquive les blocs et essaie de battre ton meilleur score.\u003c/p>\u003cbutton class=\"btn\" onclick=\"openGame('dodge')\">Jouer ▶\u003c/button>\u003c/div>\u003c/article>\n  \u003carticle class=\"card\">\u003cdiv class=\"art\">🧠\u003c/div>\u003cdiv class=\"cardbody\">\u003ch3>Memory Mix\u003c/h3>\u003cp>Retourne les cartes et retrouve toutes les paires.\u003c/p>\u003cbutton class=\"btn\" onclick=\"openGame('memory')\">Jouer ▶\u003c/button>\u003c/div>\u003c/article>\n  \u003carticle class=\"card\">\u003cdiv class=\"art\">🧱\u003c/div>\u003cdiv class=\"cardbody\">\u003ch3>Block Builder\u003c/h3>\u003cp>Place des blocs et invente une petite construction.\u003c/p>\u003cbutton class=\"btn\" onclick=\"openGame('blocks')\">Jouer ▶\u003c/button>\u003c/div>\u003c/article>\n  \u003carticle class=\"card\">\u003cdiv class=\"art\">🏎️\u003c/div>\u003cdiv class=\"cardbody\">\u003ch3>Mini Racer\u003c/h3>\u003cp>Déplace ta voiture pour éviter les obstacles sur la route.\u003c/p>\u003cbutton class=\"btn\" onclick=\"openGame('racer')\">Jouer ▶\u003c/button>\u003c/div>\u003c/article>\n  \u003carticle class=\"card\">\u003cdiv class=\"art\">⚽\u003c/div>\u003cdiv class=\"cardbody\">\u003ch3>Mini Soccer\u003c/h3>\u003cp>Clique sur le ballon pour marquer le plus de points possible.\u003c/p>\u003cbutton class=\"btn\" onclick=\"openGame('soccer')\">Jouer ▶\u003c/button>\u003c/div>\u003c/article>\n  \u003carticle class=\"card\">\u003cdiv class=\"art\">🎯\u003c/div>\u003cdiv class=\"cardbody\">\u003ch3>Click Challenge\u003c/h3>\u003cp>Clique sur la cible le plus vite possible pour gagner des points.\u003c/p>\u003cbutton class=\"btn\" onclick=\"openGame('target')\">Jouer ▶\u003c/button>\u003c/div>\u003c/article>\n \u003c/div>\n \u003ch2>👕 Ton personnage\u003c/h2>\u003cdiv class=\"panel\">\u003cp class=\"muted\">Choisis tes couleurs et crée ton propre look.\u003c/p>\u003cbutton class=\"btn primary\" onclick=\"showPage('skins')\">Ouvrir le créateur de skins\u003c/button>\u003c/div>\n\u003c/section>\n\u003csection class=\"page\" id=\"skins\">\n \u003ch2>👕 Créateur de skins\u003c/h2>\u003cp class=\"muted\">Personnalise ton avatar. Tes choix sont enregistrés sur cet appareil.\u003c/p>\n \u003cdiv class=\"panel avatar-wrap\">\u003cdiv class=\"avatar\">\u003csvg viewBox=\"0 0 100 150\" aria-label=\"Aperçu de l'avatar\">\u003crect x=\"30\" y=\"8\" width=\"40\" height=\"38\" rx=\"8\" id=\"head\" fill=\"#f0c7a2\"/>\u003ccircle cx=\"42\" cy=\"25\" r=\"3\" fill=\"#182039\"/>\u003ccircle cx=\"58\" cy=\"25\" r=\"3\" fill=\"#182039\"/>\u003cpath d=\"M42 35 Q50 41 58 35\" stroke=\"#182039\" stroke-width=\"2\" fill=\"none\"/>\u003crect x=\"24\" y=\"49\" width=\"52\" height=\"48\" rx=\"8\" id=\"shirt\" fill=\"#52b6ff\"/>\u003crect x=\"8\" y=\"51\" width=\"15\" height=\"43\" rx=\"6\" id=\"arm1\" fill=\"#f0c7a2\"/>\u003crect x=\"77\" y=\"51\" width=\"15\" height=\"43\" rx=\"6\" id=\"arm2\" fill=\"#f0c7a2\"/>\u003crect x=\"29\" y=\"99\" width=\"18\" height=\"42\" rx=\"5\" id=\"leg1\" fill=\"#394b7d\"/>\u003crect x=\"53\" y=\"99\" width=\"18\" height=\"42\" rx=\"5\" id=\"leg2\" fill=\"#394b7d\"/>\u003c/svg>\u003c/div>\u003cdiv style=\"flex:1;min-width:220px\">\u003ch3>Couleur du t-shirt\u003c/h3>\u003cdiv class=\"options\" id=\"shirts\">\u003cbutton class=\"swatch\" style=\"background:#52b6ff\" data-color=\"#52b6ff\" aria-label=\"Bleu\">\u003c/button>\u003cbutton class=\"swatch\" style=\"background:#a66bff\" data-color=\"#a66bff\" aria-label=\"Violet\">\u003c/button>\u003cbutton class=\"swatch\" style=\"background:#4ce0a1\" data-color=\"#4ce0a1\" aria-label=\"Vert\">\u003c/button>\u003cbutton class=\"swatch\" style=\"background:#ffb454\" data-color=\"#ffb454\" aria-label=\"Orange\">\u003c/button>\u003cbutton class=\"swatch\" style=\"background:#ff6384\" data-color=\"#ff6384\" aria-label=\"Rose\">\u003c/button>\u003c/div>\u003ch3>Couleur du pantalon\u003c/h3>\u003cdiv class=\"options\" id=\"pants\">\u003cbutton class=\"swatch\" style=\"background:#394b7d\" data-color=\"#394b7d\" aria-label=\"Bleu foncé\">\u003c/button>\u003cbutton class=\"swatch\" style=\"background:#313640\" data-color=\"#313640\" aria-label=\"Gris\">\u003c/button>\u003cbutton class=\"swatch\" style=\"background:#8c573d\" data-color=\"#8c573d\" aria-label=\"Marron\">\u003c/button>\u003cbutton class=\"swatch\" style=\"background:#e6e8ef\" data-color=\"#e6e8ef\" aria-label=\"Blanc\">\u003c/button>\u003c/div>\u003ch3>Couleur de peau\u003c/h3>\u003cdiv class=\"options\" id=\"skins\">\u003cbutton class=\"swatch\" style=\"background:#f0c7a2\" data-color=\"#f0c7a2\" aria-label=\"Clair\">\u003c/button>\u003cbutton class=\"swatch\" style=\"background:#c8875b\" data-color=\"#c8875b\" aria-label=\"Moyen\">\u003c/button>\u003cbutton class=\"swatch\" style=\"background:#75452f\" data-color=\"#75452f\" aria-label=\"Foncé\">\u003c/button>\u003c/div>\u003cbutton class=\"btn primary\" id=\"saveSkin\">💾 Enregistrer mon skin\u003c/button>\u003cspan class=\"muted\" id=\"skinMsg\">\u003c/span>\u003c/div>\u003c/div>\n \u003cp>\u003cbutton class=\"btn\" onclick=\"showPage('home')\">← Retour au lobby\u003c/button>\u003c/p>\n\u003c/section>\n\u003csection class=\"page\" id=\"playPage\">\u003cdiv class=\"gamebox\">\u003cbutton class=\"btn\" onclick=\"stopGame()\">← Retour au lobby\u003c/button>\u003ch2 id=\"gameTitle\">Mini-jeu\u003c/h2>\u003cdiv id=\"gameArea\">\u003c/div>\u003cp class=\"message\" id=\"gameMsg\">\u003c/p>\u003cdiv class=\"gamecontrols\">\u003cbutton class=\"btn primary\" id=\"restartGame\">Recommencer\u003c/button>\u003c/div>\u003c/div>\u003c/section>\n\u003cdiv class=\"footer\">© 2026 Anddrew et Mathéo · Mini-jeux originaux en solo\u003cbr>Cette première version est une démo locale. Aucun compte, serveur ou paiement n'est nécessaire.\u003c/div>\n\u003c/main>\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js\">\u003c/script>\n\u003cscript>\nfunction showPage(name){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(name==='home'?'home':name==='skins'?'skins':'playPage').classList.add('active');window.scrollTo({top:0,behavior:'smooth'})}\nlet shirtColor='#52b6ff',pantColor='#394b7d',skinColor='#f0c7a2',currentGame='',animationId=null;\nfunction applySkin(){document.getElementById('shirt').setAttribute('fill',shirtColor);document.getElementById('leg1').setAttribute('fill',pantColor);document.getElementById('leg2').setAttribute('fill',pantColor);['head','arm1','arm2'].forEach(id=>document.getElementById(id).setAttribute('fill',skinColor))}\nfunction setupSwatches(id,fn){document.querySelectorAll('#'+id+' .swatch').forEach(b=>b.addEventListener('click',()=>{fn(b.dataset.color);applySkin()}))}\nsetupSwatches('shirts',c=>shirtColor=c);setupSwatches('pants',c=>pantColor=c);setupSwatches('skins',c=>skinColor=c);\ntry{const saved=JSON.parse(localStorage.getItem('anddrewSkin')||'null');if(saved){shirtColor=saved.shirt;pantColor=saved.pants;skinColor=saved.skin;applySkin()}}catch(e){}\ndocument.getElementById('saveSkin').onclick=()=>{try{localStorage.setItem('anddrewSkin',JSON.stringify({shirt:shirtColor,pants:pantColor,skin:skinColor}));document.getElementById('skinMsg').textContent=' Skin enregistré !'}catch(e){document.getElementById('skinMsg').textContent=' Skin appliqué pour cette session.'}};\nfunction openGame(name){currentGame=name;showPage('playPage');startGame(name)}\nfunction stopGame(){if(animationId)cancelAnimationFrame(animationId);animationId=null;showPage('home')}\ndocument.getElementById('restartGame').onclick=()=>startGame(currentGame);\nfunction startGame(name){if(animationId)cancelAnimationFrame(animationId);animationId=null;const area=document.getElementById('gameArea'),msg=document.getElementById('gameMsg'),title=document.getElementById('gameTitle');area.innerHTML='';msg.textContent='';const titles={dodge:'⚡ Neon Dodge',memory:'🧠 Memory Mix',blocks:'🧱 Block Builder',racer:'🏎️ Mini Racer',soccer:'⚽ Mini Soccer',target:'🎯 Click Challenge'};title.textContent=titles[name]||'Mini-jeu';\nif(name==='memory'){let vals=['🍉','🚀','🎲','🐸','⭐','🎧','🍉','🚀','🎲','🐸','⭐','🎧'].sort(()=>Math.random()-.5),first=null,lock=false,pairs=0;area.innerHTML='\u003cp class=\"muted\" style=\"text-align:center\">Retrouve les 6 paires !\u003c/p>\u003cdiv id=\"memoryGrid\" style=\"display:grid;grid-template-columns:repeat(4,minmax(45px,75px));gap:8px;justify-content:center\">\u003c/div>';vals.forEach(v=>{let b=document.createElement('button');b.textContent='❔';b.style.cssText='height:65px;font-size:1.6rem;border:1px solid #4b6494;border-radius:10px;background:#24385d;color:white';b.onclick=()=>{if(lock||b.dataset.open)return;b.textContent=v;b.dataset.open='1';if(!first){first=b;return}lock=true;if(first.textContent===b.textContent){pairs++;first=null;lock=false;msg.textContent='Paires trouvées : '+pairs+'/6';if(pairs===6)msg.textContent='Bravo ! Tu as trouvé toutes les paires 🎉'}else{let f=first;setTimeout(()=>{f.textContent='❔';b.textContent='❔';delete f.dataset.open;delete b.dataset.open;first=null;lock=false},650)}};document.getElementById('memoryGrid').appendChild(b)});return}\nif(name==='blocks'){area.innerHTML='\u003cp class=\"muted\" style=\"text-align:center\">Clique sur les cases pour placer ou enlever des blocs.\u003c/p>\u003cdiv id=\"blockGrid\" style=\"display:grid;grid-template-columns:repeat(8,minmax(20px,38px));gap:4px;justify-content:center\">\u003c/div>\u003cp style=\"text-align:center\">Blocs placés : \u003cb id=\"blockCount\">0\u003c/b>\u003c/p>';let count=0;for(let i=0;i\u003c40;i++){let b=document.createElement('button');b.textContent='·';b.style.cssText='height:35px;background:#182847;color:white;border:1px solid #3b527b;border-radius:5px';b.onclick=()=>{if(b.textContent==='🧱'){b.textContent='·';count--}else{b.textContent='🧱';count++}document.getElementById('blockCount').textContent=count};document.getElementById('blockGrid').appendChild(b)}return}\nif(name==='dodge'){area.innerHTML='\u003cp class=\"muted\" style=\"text-align:center\">Utilise les flèches ou les boutons pour éviter les blocs.\u003c/p>\u003cp style=\"text-align:center\">Score : \u003cb id=\"score\">0\u003c/b>\u003c/p>\u003ccanvas id=\"canvas\" width=\"360\" height=\"260\">\u003c/canvas>\u003cdiv class=\"gamecontrols\">\u003cbutton class=\"btn\" id=\"left\">⬅️ Gauche\u003c/button>\u003cbutton class=\"btn\" id=\"right\">Droite ➡️\u003c/button>\u003c/div>';const c=document.getElementById('canvas'),ctx=c.getContext('2d');let x=166,obs=[],score=0,dead=false,tick=0;function left(){x=Math.max(8,x-24)}function right(){x=Math.min(324,x+24)}document.getElementById('left').onclick=left;document.getElementById('right').onclick=right;function key(e){if(e.key==='ArrowLeft')left();if(e.key==='ArrowRight')right()}window.addEventListener('keydown',key);const oldStop=stopGame;function draw(){ctx.fillStyle='#0b152b';ctx.fillRect(0,0,360,260);ctx.strokeStyle='#52678f';ctx.setLineDash([12,12]);ctx.beginPath();ctx.moveTo(180,0);ctx.lineTo(180,260);ctx.stroke();ctx.setLineDash([]);if(tick++%28===0)obs.push({x:Math.random()*326,y:-20});ctx.fillStyle=name==='racer'?'#4da8ff':'#4ce0a1';ctx.fillRect(x,218,28,28);ctx.fillStyle='#ff6c91';obs.forEach(o=>{o.y+=3;ctx.fillRect(o.x,o.y,22,22);if(o.y>210&&o.y\u003c246&&Math.abs(o.x-x)\u003c25)dead=true});obs=obs.filter(o=>o.y\u003c280);if(!dead){score++;document.getElementById('score').textContent=Math.floor(score/8);animationId=requestAnimationFrame(draw)}else{msg.textContent='Fin de partie ! Score : '+Math.floor(score/8)+'. Appuie sur Recommencer pour rejouer.';window.removeEventListener('keydown',key)}}draw();return}\nif(name==='racer'){\n area.innerHTML='\u003cp class=\"muted\" style=\"text-align:center\">🏎️ Mini Racing 3D : évite les blocs rouges ! Utilise les flèches, A/D ou les boutons.\u003c/p>\u003cp style=\"text-align:center\">Distance : \u003cb id=\"raceScore\">0\u003c/b> m\u003c/p>\u003cdiv id=\"raceView\" style=\"position:relative;width:100%;height:min(58vh,440px);min-height:300px;overflow:hidden;border-radius:14px;background:#8bc9f0\">\u003cdiv id=\"raceMsg\" style=\"position:absolute;top:42%;left:5%;right:5%;text-align:center;color:white;font-weight:900;font-size:1.4rem;text-shadow:0 2px 5px #000;z-index:2;pointer-events:none\">\u003c/div>\u003c/div>\u003cdiv class=\"gamecontrols\" style=\"margin-top:12px\">\u003cbutton class=\"btn\" id=\"raceLeft\" style=\"min-width:100px\">⬅️ Gauche\u003c/button>\u003cbutton class=\"btn\" id=\"raceRight\" style=\"min-width:100px\">Droite ➡️\u003c/button>\u003c/div>';\n if(!window.THREE){area.innerHTML='\u003cp>La 3D nécessite une connexion Internet. Recharge la page avec Internet activé.\u003c/p>';return}\n const view=document.getElementById('raceView');\n const scene=new THREE.Scene();scene.background=new THREE.Color(0x8bc9f0);scene.fog=new THREE.Fog(0x8bc9f0,35,150);\n const camera=new THREE.PerspectiveCamera(65,1,.1,220);camera.position.set(0,6.5,12);camera.lookAt(0,0,-12);\n const renderer=new THREE.WebGLRenderer({antialias:true, powerPreference:'high-performance'});renderer.setPixelRatio(Math.min(devicePixelRatio||1,1.5));renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.setClearColor(0x8bc9f0);view.appendChild(renderer.domElement);renderer.domElement.style.cssText='display:block;width:100%;height:100%;';\n scene.add(new THREE.HemisphereLight(0xeaf7ff,0x43533a,2));const sun=new THREE.DirectionalLight(0xffffff,2.5);sun.position.set(-7,14,8);sun.castShadow=true;scene.add(sun);\n const material=(color,rough=.8,metal=0)=>new THREE.MeshStandardMaterial({color,roughness:rough,metalness:metal});\n const grass=new THREE.Mesh(new THREE.PlaneGeometry(220,240),material(0x4f8a45));grass.rotation.x=-Math.PI/2;grass.position.set(0,-.13,-70);scene.add(grass);\n const asphalt=material(0x30363d,.95),lineMat=material(0xf4e7b7),edgeMat=material(0xe8e8e8),red=material(0xe92c38,.3,.25),dark=material(0x151a20,.6),glass=material(0x4b899d,.2,.25),silver=material(0xc5d0d6,.25,.7);\n const road=new THREE.Mesh(new THREE.PlaneGeometry(13,220),asphalt);road.rotation.x=-Math.PI/2;road.position.set(0,0,-70);scene.add(road);\n for(const x of [-6.25,6.25]){const e=new THREE.Mesh(new THREE.BoxGeometry(.12,.025,220),edgeMat);e.position.set(x,.015,-70);scene.add(e)}\n const stripes=[];for(let z=15;z>-180;z-=12){const m=new THREE.Mesh(new THREE.BoxGeometry(.16,.035,5),lineMat);m.position.set(0,.025,z);scene.add(m);stripes.push(m)}\n // Petits arbres et bâtiments au bord de la route pour donner de la profondeur.\n for(let i=0;i\u003c45;i++){const z=12-i*4.5;for(const side of [-1,1]){const x=side*(9+Math.random()*12);if(i%3===0){const trunk=new THREE.Mesh(new THREE.CylinderGeometry(.16,.23,1.5,7),material(0x65452b));trunk.position.set(x,.7,z);scene.add(trunk);const crown=new THREE.Mesh(new THREE.ConeGeometry(1.05,2.8,7),material(0x276b3d));crown.position.set(x,2.55,z);scene.add(crown)}else{const h=2+Math.random()*8,w=1.5+Math.random()*2;const b=new THREE.Mesh(new THREE.BoxGeometry(w,h,w),material([0xb5b9bc,0xd0b89b,0x929fa7][i%3]));b.position.set(x,h/2,z);scene.add(b);for(let y=1.5;y\u003ch;y+=1.8){const win=new THREE.Mesh(new THREE.BoxGeometry(w*.55,.45,.04),glass);win.position.set(x,y,z+w/2+.025);scene.add(win)}}}}\n const car=new THREE.Group();scene.add(car);\n function box(parent,w,h,d,mat,x,y,z){const o=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);o.position.set(x,y,z);o.castShadow=true;o.receiveShadow=true;parent.add(o);return o}\n box(car,1.65,.48,3.15,red,0,.65,0);box(car,1.28,.55,1.55,glass,0,1.12,-.18);box(car,1.58,.14,.72,red,0,.91,-1.05);box(car,1.5,.13,.6,red,0,.9,1.12);box(car,.4,.13,.08,material(0xfff0b5,.2),-.52,.72,-1.59);box(car,.4,.13,.08,material(0xfff0b5,.2),.52,.72,-1.59);\n for(const x of [-.87,.87])for(const z of [-1,1]){const tire=new THREE.Mesh(new THREE.CylinderGeometry(.34,.34,.22,18),dark);tire.rotation.z=Math.PI/2;tire.position.set(x,.36,z);tire.castShadow=true;car.add(tire);const hub=new THREE.Mesh(new THREE.CylinderGeometry(.17,.17,.235,14),silver);hub.rotation.z=Math.PI/2;hub.position.copy(tire.position);car.add(hub)}\n car.position.set(0,0,5);\n const obstacles=[];function makeObstacle(z){const g=new THREE.Group();const w=1.1+Math.random()*.45,h=.8+Math.random()*.65;const block=new THREE.Mesh(new THREE.BoxGeometry(w,h,1.1),red);block.position.y=h/2;block.castShadow=true;g.add(block);const stripe=new THREE.Mesh(new THREE.BoxGeometry(w*.72,.12,1.13),material(0xffd44a));stripe.position.y=h*.65;g.add(stripe);g.position.set([-4,0,4][Math.floor(Math.random()*3)],0,z);scene.add(g);obstacles.push(g)}\n let lane=0,score=0,elapsed=0,spawn=0,dead=false,prev=performance.now();const held={};\n function moveLane(d){if(dead)return;lane=Math.max(-1,Math.min(1,lane+d))}\n const lbtn=document.getElementById('raceLeft'),rbtn=document.getElementById('raceRight');lbtn.addEventListener('pointerdown',e=>{e.preventDefault();moveLane(-1)});rbtn.addEventListener('pointerdown',e=>{e.preventDefault();moveLane(1)});\n function keyRace(e){if(['ArrowLeft','a','A','ArrowRight','d','D'].includes(e.key)){e.preventDefault();if(e.repeat)return;if(e.key==='ArrowLeft'||e.key.toLowerCase()==='a')moveLane(-1);else moveLane(1)}}window.addEventListener('keydown',keyRace);\n function resizeRace(){const w=Math.max(1,view.clientWidth),h=Math.max(1,view.clientHeight);camera.aspect=w/h;camera.updateProjectionMatrix();renderer.setSize(w,h,false)}resizeRace();const ro=new ResizeObserver(resizeRace);ro.observe(view);\n function raceFrame(now){if(currentGame!=='racer')return;animationId=requestAnimationFrame(raceFrame);const dt=Math.min((now-prev)/1000,.04);prev=now;if(!dead){elapsed+=dt;spawn+=dt;score+=dt*18;if(spawn>Math.max(.42,1.05-elapsed*.006)){spawn=0;makeObstacle(-100)}car.position.x+=(lane*4-car.position.x)*Math.min(1,dt*7);stripes.forEach(s=>{s.position.z+=dt*(22+Math.min(score*.05,18));if(s.position.z>18)s.position.z=-180});obstacles.forEach(o=>{o.position.z+=dt*(22+Math.min(score*.05,18));if(Math.abs(o.position.z-car.position.z)\u003c1.6&&Math.abs(o.position.x-car.position.x)\u003c1.45)dead=true});for(let i=obstacles.length-1;i>=0;i--)if(obstacles[i].position.z>18){scene.remove(obstacles[i]);obstacles.splice(i,1)}document.getElementById('raceScore').textContent=Math.floor(score);if(dead){document.getElementById('raceMsg').innerHTML='💥 CRASH !\u003cbr>\u003cspan style=\"font-size:1rem\">Distance : '+Math.floor(score)+' m\u003c/span>';msg.textContent='Appuie sur « Recommencer » pour retenter ta chance.'}}\n camera.position.x+=(car.position.x*.38-camera.position.x)*Math.min(1,dt*2);camera.lookAt(car.position.x*.35,0,-12);renderer.render(scene,camera)}raceFrame(performance.now());return\n}\nif(name==='soccer'){let score=0;area.innerHTML='\u003cp class=\"muted\" style=\"text-align:center\">Clique sur le ballon pour marquer des points !\u003c/p>\u003cp style=\"text-align:center\">Buts : \u003cb id=\"goals\">0\u003c/b>\u003c/p>\u003cbutton id=\"ball\" style=\"display:block;margin:35px auto;font-size:4rem;border:0;background:transparent\">⚽\u003c/button>';const b=document.getElementById('ball');b.onclick=()=>{score++;document.getElementById('goals').textContent=score;b.style.transform='translate('+((Math.random()-.5)*120)+'px,'+((Math.random()-.5)*50)+'px)'};return}\nif(name==='target'){let score=0,time=15;area.innerHTML='\u003cp style=\"text-align:center\">Tu as 15 secondes pour cliquer sur la cible !\u003c/p>\u003cp style=\"text-align:center\">Temps : \u003cb id=\"time\">15\u003c/b> s · Score : \u003cb id=\"tscore\">0\u003c/b>\u003c/p>\u003cdiv style=\"height:190px;position:relative;background:#091226;border-radius:12px;overflow:hidden\">\u003cbutton id=\"target\" style=\"position:absolute;left:40%;top:35%;font-size:2rem;border:0;background:transparent\">🎯\u003c/button>\u003c/div>';const target=document.getElementById('target'),box=target.parentElement;target.onclick=()=>{if(time\u003c=0)return;score++;document.getElementById('tscore').textContent=score;target.style.left=Math.random()*80+'%';target.style.top=Math.random()*70+'%'};const timer=setInterval(()=>{time--;const t=document.getElementById('time');if(t)t.textContent=time;if(time\u003c=0){clearInterval(timer);target.disabled=true;msg.textContent='Terminé ! Ton score : '+score}},1000);return}\n}\n\u003c/script>\n\u003c/body>\n\u003c/html>"},
{title:"Real City 3D",icon:"🏙️",category:"Exploration 3D",html:"\u003c!DOCTYPE html>\n\u003chtml lang=\"fr\">\n\u003chead>\n\u003cmeta charset=\"UTF-8\">\n\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n\u003ctitle>Real City 3D\u003c/title>\n\u003cstyle>\n*{box-sizing:border-box}\nbody{margin:0;overflow:hidden;background:#83b6df;font-family:Arial}\n#hud{position:fixed;top:10px;left:10px;color:white;background:#101820dc;\npadding:12px;border-radius:10px;z-index:5;font-size:13px;line-height:1.7}\n#controls{position:fixed;bottom:18px;right:12px;display:grid;\ngrid-template-columns:55px 55px 55px;gap:5px;z-index:5}\nbutton{background:#17232edb;color:white;border:1px solid #ffffff60;\nborder-radius:12px;height:52px;font-size:23px;touch-action:none}\n.empty{visibility:hidden}\n#action{position:fixed;bottom:22px;left:12px;width:100px;\nheight:58px;font-size:13px;z-index:5}\n#help{position:fixed;bottom:5px;left:12px;color:white;font-size:10px}\n\u003c/style>\n\u003c/head>\n\u003cbody>\n\n\u003cdiv id=\"hud\">\n\u003cb>REAL CITY 3D\u003c/b>\u003cbr>\nMultijoueur : \u003cspan id=\"multiStatus\">Configuration nécessaire\u003c/span>\u003cbr>\nMode : \u003cspan id=\"mode\">Voiture\u003c/span>\u003cbr>\nVitesse : \u003cspan id=\"speed\">0\u003c/span> km/h\u003cbr>\nQuartier : Downtown\u003cbr>\n\u003cbutton onclick=\"resetGame()\" style=\"height:30px;font-size:12px\">Recommencer\u003c/button>\n\u003c/div>\n\n\u003cbutton id=\"action\" onclick=\"switchMode()\">SORTIR\u003c/button>\n\n\u003cdiv id=\"controls\">\n\u003cdiv class=\"empty\">\u003c/div>\u003cbutton data-k=\"up\">▲\u003c/button>\u003cdiv class=\"empty\">\u003c/div>\n\u003cbutton data-k=\"left\">◀\u003c/button>\u003cbutton data-k=\"down\">▼\u003c/button>\n\u003cbutton data-k=\"right\">▶\u003c/button>\n\u003c/div>\n\n\u003cdiv id=\"help\">ZQSD/WASD : bouger · E : entrer/sortir\u003c/div>\n\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js\">\u003c/script>\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2\">\u003c/script>\n\u003cscript>\nif(!window.THREE){\ndocument.body.innerHTML=\"Connexion Internet nécessaire pour charger le jeu 3D.\";\nthrow Error(\"Three.js indisponible\");\n}\n\n// MOTEUR 3D\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color(0x9dc7e8);\nscene.fog=new THREE.Fog(0x9dc7e8,100,650);\n\nconst camera=new THREE.PerspectiveCamera(68,innerWidth/innerHeight,.1,1800);\n\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.setPixelRatio(Math.min(devicePixelRatio,1.5));\nrenderer.shadowMap.enabled=true;\nrenderer.shadowMap.type=THREE.PCFSoftShadowMap;\nrenderer.outputColorSpace=THREE.SRGBColorSpace;\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure=1.15;\ndocument.body.appendChild(renderer.domElement);\n\n// LUMIÈRES\nscene.add(new THREE.HemisphereLight(0xdceeff,0x50533c,2));\n\nconst sun=new THREE.DirectionalLight(0xffe2b0,3.5);\nsun.position.set(-100,150,80);\nsun.castShadow=true;\nsun.shadow.mapSize.set(2048,2048);\nsun.shadow.camera.left=-180;\nsun.shadow.camera.right=180;\nsun.shadow.camera.top=180;\nsun.shadow.camera.bottom=-180;\nscene.add(sun);\n\n// MATÉRIAUX\nfunction mat(c,r=.75,m=0){\nreturn new THREE.MeshStandardMaterial({color:c,roughness:r,metalness:m});\n}\nfunction cube(parent,w,h,d,material,x,y,z){\nconst o=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material);\no.position.set(x,y,z);\no.castShadow=true;\no.receiveShadow=true;\nparent.add(o);\nreturn o;\n}\n\n// SOL ET ROUTES\nconst grass=mat(0x526e43);\nconst ground=new THREE.Mesh(new THREE.PlaneGeometry(1800,1800),grass);\nground.rotation.x=-Math.PI/2;\nground.position.y=-.15;\nground.receiveShadow=true;\nscene.add(ground);\n\nconst asphalt=mat(0x292e33,.95);\nconst concrete=mat(0xb4b1a7);\nconst roadLine=mat(0xf0e6c8);\n\nfor(let p=-480;p\u003c=480;p+=60){\ncube(scene,1800,.12,20,asphalt,0,-.08,p);\ncube(scene,20,.12,1800,asphalt,p,-.08,0);\ncube(scene,1800,.12,3,concrete,0,.01,p-12);\ncube(scene,1800,.12,3,concrete,0,.01,p+12);\ncube(scene,3,.12,1800,concrete,p-12,.01,0);\ncube(scene,3,.12,1800,concrete,p+12,.01,0);\n\nfor(let x=-880;x\u003c880;x+=13)\ncube(scene,4,.015,.15,roadLine,x,.0,p);\n}\n\n// VILLE\nlet seed=24681;\nfunction random(){\nseed=(seed*16807)%2147483647;\nreturn (seed-1)/2147483646;\n}\n\nconst facades=[\n0xb4b2ad,0x8e969b,0xc8b59a,\n0x777f87,0xd2cabb,0x929fa3\n].map(c=>mat(c));\n\nconst windows=[\nmat(0x263e50,.2,.35),\nmat(0x6c9aaf,.25,.25),\nmat(0x354750,.25,.25)\n];\n\nfor(let gx=-8;gx\u003c=8;gx++){\nfor(let gz=-8;gz\u003c=8;gz++){\n\nfor(let i=0;i\u003c4;i++){\nconst x=gx*60+(random()-.5)*32;\nconst z=gz*60+(random()-.5)*32;\n\nif(Math.abs(x%60)\u003c15||Math.abs(z%60)\u003c15)continue;\n\nconst w=8+random()*10;\nconst d=8+random()*10;\nconst h=12+random()*(random()\u003c.25?100:38);\n\ncube(scene,w,h,d,facades[Math.floor(random()*facades.length)],\nx,h/2,z);\n\nconst wm=windows[Math.floor(random()*windows.length)];\n\nfor(let y=3;y\u003ch-2;y+=3.2){\nfor(let xx=-w/2+1;xx\u003cw/2-1;xx+=2.3){\ncube(scene,.95,1.4,.06,wm,x+xx,y,z+d/2+.04);\ncube(scene,.06,1.4,.95,wm,x+w/2+.04,y,z+xx);\n}\n}\n\nif(h>40){\ncube(scene,w*.4,1,d*.4,mat(0x53585c),x,h+.5,z);\n}\n}\n}\n}\n\n// ARBRES\nconst bark=mat(0x5b402c);\nconst leaves=[\nmat(0x2c5534),mat(0x426d3e),mat(0x547c43)\n];\n\nfunction tree(x,z,s){\nconst trunk=new THREE.Mesh(\nnew THREE.CylinderGeometry(.2*s,.3*s,2.8*s,8),bark);\ntrunk.position.set(x,1.4*s,z);\ntrunk.castShadow=true;\nscene.add(trunk);\n\nconst crown=new THREE.Mesh(\nnew THREE.SphereGeometry(1.5*s,10,8),\nleaves[Math.floor(random()*leaves.length)]);\ncrown.position.set(x,3.4*s,z);\ncrown.scale.y=1.2;\ncrown.castShadow=true;\nscene.add(crown);\n}\n\nfor(let i=0;i\u003c450;i++){\nconst x=(random()-.5)*950;\nconst z=(random()-.5)*950;\nif(Math.abs(x%60)\u003c14||Math.abs(z%60)\u003c14)continue;\ntree(x,z,.6+random()*.6);\n}\n\n// VOITURE SPORT\nconst car=new THREE.Group();\nscene.add(car);\n\nconst paint=mat(0xb5101c,.23,.6);\nconst black=mat(0x111519,.4,.2);\nconst glass=mat(0x183443,.16,.5);\nconst rubber=mat(0x171819,.9);\nconst chrome=mat(0xa8b0b5,.25,.8);\n\ncube(car,2.2,.48,4.5,paint,0,.7,0);\ncube(car,1.8,.3,3.3,paint,0,1,-.1);\ncube(car,1.5,.62,1.85,glass,0,1.35,-.25);\ncube(car,1.9,.12,1.2,paint,0,.99,-1.6);\ncube(car,1.9,.12,.8,paint,0,.99,1.7);\ncube(car,1.7,.12,.18,black,0,1.35,1.9);\n\nfor(const x of [-1.1,1.1]){\nfor(const z of [-1.45,1.45]){\nconst wheel=new THREE.Group();\nwheel.position.set(x,.42,z);\ncar.add(wheel);\n\nconst tire=new THREE.Mesh(\nnew THREE.CylinderGeometry(.43,.43,.3,24),rubber);\ntire.rotation.z=Math.PI/2;\ntire.castShadow=true;\nwheel.add(tire);\n\nconst hub=new THREE.Mesh(\nnew THREE.CylinderGeometry(.23,.23,.31,16),chrome);\nhub.rotation.z=Math.PI/2;\nwheel.add(hub);\nwheel.userData.tire=tire;\nwheel.userData.hub=hub;\n}\n}\n\nconst lamp=mat(0xffefbd,.2);\nlamp.emissive.setHex(0xffd06a);\nlamp.emissiveIntensity=.6;\n\nfor(const x of [-.72,.72]){\ncube(car,.4,.14,.07,lamp,x,.82,-2.27);\ncube(car,.38,.13,.07,mat(0xff2222),x,.82,2.27);\n}\n\n// PERSONNAGE\nconst player=new THREE.Group();\nscene.add(player);\n\nconst shirt=mat(0x222a36);\nconst skin=mat(0xb77d58);\nconst pants=mat(0x303d4d);\nconst shoes=mat(0xe7e7e7);\n\ncube(player,.62,.8,.36,shirt,0,1.35,0);\ncube(player,.43,.45,.43,skin,0,1.98,0);\ncube(player,.49,.14,.48,black,0,2.23,0);\n\nconst legs=[];\nfor(const x of [-.17,.17]){\nconst leg=cube(player,.24,.68,.27,pants,x,.62,0);\nlegs.push(leg);\ncube(player,.27,.16,.4,shoes,x,.17,-.04);\n}\nfor(const x of [-.42,.42])\ncube(player,.19,.7,.22,shirt,x,1.35,0);\n\nplayer.visible=false;\n\n// MULTIJOUEUR SUPABASE\n// Remplace uniquement ces deux valeurs par l'URL du projet et la Publishable Key.\n// N'utilise JAMAIS la Secret key ici.\nconst SUPABASE_URL = \"COLLE_ICI_L_URL_DU_PROJET\";\nconst SUPABASE_PUBLISHABLE_KEY = \"COLLE_ICI_LA_PUBLISHABLE_KEY\";\nconst multiplayerId = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random());\nconst remotePlayers = new Map();\nlet multiplayerChannel = null;\nlet lastBroadcast = 0;\n\nfunction makeRemoteAvatar(){\n  const group = new THREE.Group();\n  const remoteBodyMat = mat(0x2d78d4);\n  const remoteSkinMat = mat(0xb77d58);\n  const remoteWheelMat = mat(0x171819);\n  const remoteCarMat = mat(0xe5a321, .25, .35);\n  const remoteGlassMat = mat(0x183443, .2, .3);\n  const remoteCar = new THREE.Group();\n  cube(remoteCar, 2.2, .48, 4.5, remoteCarMat, 0, .7, 0);\n  cube(remoteCar, 1.5, .62, 1.85, remoteGlassMat, 0, 1.35, -.25);\n  for(const x of [-1.1,1.1]){\n    for(const z of [-1.45,1.45]){\n      const tire = new THREE.Mesh(new THREE.CylinderGeometry(.43,.43,.3,12), remoteWheelMat);\n      tire.rotation.z = Math.PI/2;\n      tire.position.set(x,.42,z);\n      remoteCar.add(tire);\n    }\n  }\n  group.add(remoteCar);\n  const remotePerson = new THREE.Group();\n  cube(remotePerson,.62,.8,.36,remoteBodyMat,0,1.35,0);\n  cube(remotePerson,.43,.45,.43,remoteSkinMat,0,1.98,0);\n  remotePerson.visible = false;\n  group.add(remotePerson);\n  scene.add(group);\n  return {group, remoteCar, remotePerson};\n}\n\nfunction setMultiStatus(text){\n  const el = document.getElementById(\"multiStatus\");\n  if(el) el.textContent = text;\n}\n\nfunction connectMultiplayer(){\n  if(!window.supabase){\n    setMultiStatus(\"Bibliothèque indisponible\");\n    return;\n  }\n  if(SUPABASE_URL.startsWith(\"COLLE_ICI\") || SUPABASE_PUBLISHABLE_KEY.startsWith(\"COLLE_ICI\")){\n    setMultiStatus(\"URL et clé à ajouter\");\n    return;\n  }\n  try{\n    const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);\n    multiplayerChannel = client.channel(\"real-city-3d-room\", {\n      config: {broadcast: {self: false}, presence: {key: multiplayerId}}\n    });\n    multiplayerChannel\n      .on(\"broadcast\", {event: \"player\"}, ({payload}) => {\n        if(!payload || payload.id === multiplayerId) return;\n        let remote = remotePlayers.get(payload.id);\n        if(!remote){\n          remote = makeRemoteAvatar();\n          remotePlayers.set(payload.id, remote);\n        }\n        const target = payload.inCar ? remote.remoteCar : remote.remotePerson;\n        remote.remoteCar.visible = !!payload.inCar;\n        remote.remotePerson.visible = !payload.inCar;\n        target.position.set(payload.x || 0, 0, payload.z || 0);\n        target.rotation.y = payload.angle || 0;\n      })\n      .on(\"presence\", {event: \"leave\"}, ({key}) => {\n        const remote = remotePlayers.get(key);\n        if(remote){\n          scene.remove(remote.group);\n          remotePlayers.delete(key);\n        }\n      })\n      .subscribe((status) => {\n        if(status === \"SUBSCRIBED\") setMultiStatus(\"Connecté — entrez dans le même salon\");\n        else if(status === \"CHANNEL_ERROR\" || status === \"TIMED_OUT\") setMultiStatus(\"Connexion impossible\");\n      });\n  }catch(error){\n    setMultiStatus(\"Erreur de configuration\");\n    console.error(\"Supabase multijoueur:\", error);\n  }\n}\n\nfunction broadcastMyPosition(now){\n  if(!multiplayerChannel || now - lastBroadcast \u003c 100) return;\n  lastBroadcast = now;\n  const obj = inCar ? car : player;\n  multiplayerChannel.send({\n    type: \"broadcast\",\n    event: \"player\",\n    payload: {id: multiplayerId, x: obj.position.x, z: obj.position.z, angle, inCar}\n  }).catch(()=>{});\n}\nconnectMultiplayer();\n\n// COMMANDES\nlet angle=Math.PI,speed=0,inCar=true;\nconst keys={},touch={};\n\nonkeydown=e=>{\nkeys[e.key.toLowerCase()]=true;\nif(e.key.toLowerCase()===\"e\"&&!e.repeat)switchMode();\n};\nonkeyup=e=>keys[e.key.toLowerCase()]=false;\n\ndocument.querySelectorAll(\"[data-k]\").forEach(b=>{\nconst k=b.dataset.k;\nb.addEventListener(\"pointerdown\",e=>{\ne.preventDefault();touch[k]=true;\n});\nconst release=()=>touch[k]=false;\nb.addEventListener(\"pointerup\",release);\nb.addEventListener(\"pointercancel\",release);\nb.addEventListener(\"pointerleave\",release);\n});\n\n// ENTRER ET SORTIR\nfunction switchMode(){\nif(inCar){\nplayer.position.set(\ncar.position.x+Math.cos(angle)*2.7,0,\ncar.position.z-Math.sin(angle)*2.7);\nplayer.rotation.y=angle;\nplayer.visible=true;\nspeed=0;\ninCar=false;\ndocument.getElementById(\"mode\").textContent=\"À pied\";\ndocument.getElementById(\"action\").textContent=\"ENTRER\";\n}else{\nif(player.position.distanceTo(car.position)>5)return;\nplayer.visible=false;\nspeed=0;\ninCar=true;\ndocument.getElementById(\"mode\").textContent=\"Voiture\";\ndocument.getElementById(\"action\").textContent=\"SORTIR\";\n}\n}\n\nfunction resetGame(){\ncar.position.set(0,0,7);\nangle=Math.PI;\ncar.rotation.y=angle;\nspeed=0;\ninCar=true;\nplayer.visible=false;\ndocument.getElementById(\"mode\").textContent=\"Voiture\";\ndocument.getElementById(\"action\").textContent=\"SORTIR\";\n}\n\n// ANIMATION\nlet last=performance.now(),walkTime=0;\n\nfunction animate(now){\nrequestAnimationFrame(animate);\nbroadcastMyPosition(now);\nconst dt=Math.min((now-last)/1000,.035);\nlast=now;\n\nconst up=touch.up||keys.w||keys.z||keys.arrowup;\nconst down=touch.down||keys.s||keys.arrowdown;\nconst left=touch.left||keys.a||keys.q||keys.arrowleft;\nconst right=touch.right||keys.d||keys.arrowright;\n\nif(inCar){\nif(up)speed=Math.min(speed+17*dt,40);\nelse if(down)speed=Math.max(speed-24*dt,-10);\nelse speed*=Math.pow(.98,dt*60);\n\nif(Math.abs(speed)>.3){\nif(left)angle-=1.55*dt*Math.sign(speed);\nif(right)angle+=1.55*dt*Math.sign(speed);\n}\ncar.position.x+=Math.sin(angle)*speed*dt;\ncar.position.z+=Math.cos(angle)*speed*dt;\ncar.rotation.y=angle;\n\ncar.children.forEach(c=>{\nif(c.userData.tire){\nc.userData.tire.rotation.x+=speed*dt*1.8;\nc.userData.hub.rotation.x+=speed*dt*1.8;\n}\n});\n}else{\nlet movement=up?8:down?-5:0;\nif(left)angle+=2*dt;\nif(right)angle-=2*dt;\n\nplayer.rotation.y=angle;\nplayer.position.x+=Math.sin(angle)*movement*dt;\nplayer.position.z+=Math.cos(angle)*movement*dt;\n\nif(movement!==0){\nwalkTime+=dt*10;\nlegs[0].rotation.x=Math.sin(walkTime)*.6;\nlegs[1].rotation.x=-Math.sin(walkTime)*.6;\n}else{\nlegs.forEach(l=>l.rotation.x=0);\n}\n}\n\nconst targetObject=inCar?car:player;\nconst dist=inCar?10:7;\nconst target=new THREE.Vector3(\ntargetObject.position.x-Math.sin(angle)*dist,\ninCar?4.2:3.3,\ntargetObject.position.z-Math.cos(angle)*dist);\n\ncamera.position.lerp(target,1-Math.pow(.001,dt));\ncamera.lookAt(targetObject.position.x,inCar?1:1.3,\ntargetObject.position.z);\n\ndocument.getElementById(\"speed\").textContent=\nMath.round(Math.abs(inCar?speed:0)*4);\n\nrenderer.render(scene,camera);\n}\n\nanimate(performance.now());\n\nonresize=()=>{\ncamera.aspect=innerWidth/innerHeight;\ncamera.updateProjectionMatrix();\nrenderer.setSize(innerWidth,innerHeight);\n};\n\u003c/script>\n\u003c/body>\n\u003c/html>"},
{title:"Terra Moon 3D",icon:"🌲",category:"Exploration 3D",html:"\u003c!DOCTYPE html>\n\u003chtml lang=\"fr\">\n\u003chead>\n\u003cmeta charset=\"UTF-8\">\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n\u003ctitle>Terra — Monde 3D\u003c/title>\n\u003cstyle>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#b6d9ed;font-family:Arial,sans-serif;touch-action:none}canvas{display:block}\n#hud{position:fixed;top:10px;left:10px;z-index:5;color:#fff;background:#14221dcc;padding:11px 13px;border-radius:12px;max-width:90vw;font-size:14px;box-shadow:0 3px 14px #0004}\n#hint{font-size:12px;opacity:.9;margin-top:5px;line-height:1.35}\n#cross{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);color:white;font-size:24px;text-shadow:0 1px 5px #000;pointer-events:none}\n#controls{position:fixed;left:10px;right:10px;bottom:12px;z-index:6;display:flex;justify-content:space-between;align-items:end;pointer-events:none}\n.pad,.actions{pointer-events:auto}.pad{display:grid;grid-template-columns:54px 54px 54px;grid-template-rows:54px 54px 54px;gap:4px}\nbutton{background:#16251dcc;color:white;border:1px solid #ffffff66;border-radius:13px;min-width:50px;min-height:50px;font-size:18px;touch-action:none}\n.pad button:nth-child(1){grid-column:2;grid-row:1}.pad button:nth-child(2){grid-column:1;grid-row:2}.pad button:nth-child(3){grid-column:2;grid-row:2}.pad button:nth-child(4){grid-column:3;grid-row:2}\n.actions{display:flex;flex-direction:column;gap:5px;align-items:end}.actions button{font-size:13px;padding:7px}\n\u003c/style>\u003c/head>\u003cbody>\n\u003cdiv id=\"hud\">\u003cb>🌎 TERRA — EXPLORATION 3D\u003c/b>\u003cdiv id=\"status\">Préparation du paysage…\u003c/div>\u003cdiv id=\"hint\">Ordinateur : ZQSD/WASD + souris. Téléphone/tablette : boutons et glissement sur l'écran pour regarder.\u003c/div>\u003c/div>\n\u003cdiv id=\"cross\">+\u003c/div>\n\u003cdiv id=\"controls\">\u003cdiv class=\"pad\">\u003cbutton data-key=\"KeyW\">▲\u003c/button>\u003cbutton data-key=\"KeyA\">◀\u003c/button>\u003cbutton data-key=\"KeyS\">▼\u003c/button>\u003cbutton data-key=\"KeyD\">▶\u003c/button>\u003c/div>\u003cdiv class=\"actions\">\u003cbutton onclick=\"jump()\">SAUTER\u003c/button>\u003cbutton onclick=\"place()\">＋ BLOC\u003c/button>\u003cbutton onclick=\"breakOne()\">⛏ CASSER\u003c/button>\u003c/div>\u003c/div>\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js\">\u003c/script>\n\u003cscript>\nlet scene,camera,renderer,keys={},editable=[],solid=[],yaw=0,pitch=0,vy=0,onGround=true,drag=false,lx=0,ly=0,clock=new THREE.Clock();\nconst ray=new THREE.Raycaster(),center=new THREE.Vector2(0,0),SIZE=300;\nconst std=(c,r=.95,m=0)=>new THREE.MeshStandardMaterial({color:c,roughness:r,metalness:m});\nfunction addMesh(geo,material,x,y,z,editableBlock=false){let o=new THREE.Mesh(geo,material);o.position.set(x,y,z);o.castShadow=true;o.receiveShadow=true;scene.add(o);solid.push(o);if(editableBlock)editable.push(o);return o;}\nfunction h(x,z){return 2.2*Math.sin(x*.045)+1.7*Math.cos(z*.052)+2.3*Math.sin((x+z)*.025)+1.1*Math.cos(x*.09-z*.06);}\nfunction terrain(){\nconst grass=std(0x477b3d),earth=std(0x70533a),stone=std(0x747976),snow=std(0xe5e9e6),wood=std(0x61402a),leafMats=[std(0x245c32),std(0x347b3b),std(0x426f36)],sand=std(0xc8b77b);\nconst waterMat=new THREE.MeshPhysicalMaterial({color:0x368db7,roughness:.16,metalness:.1,transparent:true,opacity:.86,clearcoat:1,clearcoatRoughness:.12});\nconst step=3;\nfor(let x=-SIZE/2;x\u003cSIZE/2;x+=step)for(let z=-SIZE/2;z\u003cSIZE/2;z+=step){\n const y=h(x,z),river=Math.abs(x+z*.32-8*Math.sin(z*.035))\u003c4.5, beach=!river&&Math.abs(x+z*.32-8*Math.sin(z*.035))\u003c7;\n const top=river?-.15:y;\n let material=beach?sand:(y>5.2?stone:grass);\n addMesh(new THREE.BoxGeometry(step,Math.max(1,top+8),step),material,x,top-(Math.max(1,top+8))/2,z);\n if(y>7.5){addMesh(new THREE.BoxGeometry(step,1,step),snow,x,y+.5,z);}\n if(river)addMesh(new THREE.BoxGeometry(step,.12,step),waterMat,x,-.08,z);\n if(!river&&Math.random()\u003c.045&&Math.abs(x)>10&&Math.abs(z)>10){\n   const trunkH=2.5+Math.random()*2.8;\n   addMesh(new THREE.CylinderGeometry(.18,.28,trunkH,7),wood,x,y+trunkH/2,z);\n   for(let j=0;j\u003c3;j++){\n     const radius=1.6-j*.3,yy=y+trunkH*.65+j*.85;\n     addMesh(new THREE.ConeGeometry(radius,2.3,7),leafMats[Math.floor(Math.random()*leafMats.length)],x,yy,z);\n   }\n }\n if(!river&&Math.random()\u003c.012){\n   const s=.6+Math.random()*1.1;\n   const b=addMesh(new THREE.DodecahedronGeometry(s,0),stone,x,y+s*.4,z);\n   b.rotation.set(Math.random(),Math.random(),Math.random());\n }\n if(!river&&Math.random()\u003c.018){\n   const flower=std([0xe7d7a4,0xf0c3c7,0xd8c7ed][Math.floor(Math.random()*3)]);\n   addMesh(new THREE.SphereGeometry(.13,6,5),flower,x,y+.25,z);\n }\n}\n}\nfunction clouds(){\nconst cloudMat=new THREE.MeshStandardMaterial({color:0xffffff,roughness:1});\nfor(let i=0;i\u003c22;i++){let x=Math.random()*260-130,z=Math.random()*260-130,y=30+Math.random()*13;\nfor(let j=0;j\u003c5;j++){let s=2+Math.random()*2;addMesh(new THREE.SphereGeometry(s,8,6),cloudMat,x+(j-2)*2.4,y+Math.random()*1.2,z+Math.sin(j)*2);}}\n}\nfunction start(){\nscene=new THREE.Scene();scene.background=new THREE.Color(0xa8d2ed);scene.fog=new THREE.Fog(0xa8d2ed,95,260);\ncamera=new THREE.PerspectiveCamera(72,innerWidth/innerHeight,.1,600);camera.position.set(0,8,14);\nrenderer=new THREE.WebGLRenderer({antialias:true,powerPreference:\"high-performance\"});renderer.setSize(innerWidth,innerHeight);renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputColorSpace=THREE.SRGBColorSpace;\nrenderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.05;document.body.appendChild(renderer.domElement);\nscene.add(new THREE.HemisphereLight(0xe5f5ff,0x526044,2.2));\nlet sun=new THREE.DirectionalLight(0xfff0d6,3);sun.position.set(-60,90,35);sun.castShadow=true;sun.shadow.mapSize.set(1536,1536);sun.shadow.camera.left=-100;sun.shadow.camera.right=100;sun.shadow.camera.top=100;sun.shadow.camera.bottom=-100;scene.add(sun);\nterrain();clouds();\ndocument.getElementById('status').textContent='Paysage géant prêt • terrain, forêts, rivière, rochers et nuages';\ncontrols();window.addEventListener('resize',resize);animate();\n}\nfunction target(){ray.setFromCamera(center,camera);return ray.intersectObjects(editable,false)[0];}\nfunction place(){let hit=target();if(!hit)return;let p=hit.object.position.clone().add(hit.face.normal);if(p.distanceTo(camera.position)\u003c2)return;let b=addMesh(new THREE.BoxGeometry(1,1,1),std(0x9c7951),Math.round(p.x),Math.round(p.y),Math.round(p.z),true);}\nfunction breakOne(){let hit=target();if(!hit)return;scene.remove(hit.object);solid=solid.filter(x=>x!==hit.object);editable=editable.filter(x=>x!==hit.object);}\nfunction jump(){if(onGround){vy=.24;onGround=false;}}\nfunction controls(){\ndocument.querySelectorAll('[data-key]').forEach(b=>{let k=b.dataset.key;b.addEventListener('pointerdown',e=>{e.preventDefault();keys[k]=true;b.setPointerCapture(e.pointerId)});['pointerup','pointercancel','lostpointercapture'].forEach(ev=>b.addEventListener(ev,()=>keys[k]=false));});\nwindow.addEventListener('keydown',e=>{keys[e.code]=true;if(e.code==='Space')jump()});window.addEventListener('keyup',e=>keys[e.code]=false);\nrenderer.domElement.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'){if(innerWidth>750)renderer.domElement.requestPointerLock?.();return}drag=true;lx=e.clientX;ly=e.clientY});\nrenderer.domElement.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'&&document.pointerLockElement===renderer.domElement){yaw-=e.movementX*.004;pitch-=e.movementY*.004;look();return}if(!drag||e.pointerType==='mouse')return;yaw-=(e.clientX-lx)*.008;pitch-=(e.clientY-ly)*.008;lx=e.clientX;ly=e.clientY;look()});\nwindow.addEventListener('pointerup',()=>drag=false);\ndocument.addEventListener('mousemove',e=>{if(document.pointerLockElement===renderer.domElement){yaw-=e.movementX*.004;pitch-=e.movementY*.004;look()}});\n}\nfunction look(){pitch=Math.max(-1.35,Math.min(1.35,pitch));camera.rotation.order='YXZ';camera.rotation.set(pitch,yaw,0);}\nfunction animate(){requestAnimationFrame(animate);let dt=Math.min(clock.getDelta(),.04),speed=12*dt;\nconst f=new THREE.Vector3(-Math.sin(yaw),0,-Math.cos(yaw)),s=new THREE.Vector3(Math.cos(yaw),0,-Math.sin(yaw));\nif(keys.KeyW||keys.ArrowUp)camera.position.addScaledVector(f,speed);if(keys.KeyS||keys.ArrowDown)camera.position.addScaledVector(f,-speed);if(keys.KeyA||keys.ArrowLeft)camera.position.addScaledVector(s,-speed);if(keys.KeyD||keys.ArrowRight)camera.position.addScaledVector(s,speed);\nvy-=18*dt*dt;camera.position.y+=vy*dt*60;let floor=h(camera.position.x,camera.position.z)+2.0;if(camera.position.y\u003cfloor){camera.position.y=floor;vy=0;onGround=true;}\nrenderer.render(scene,camera);}\nfunction resize(){camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);}\nstart();\n\u003c/script>\u003c/body>\u003c/html>"},
{title:"Monde 3D",icon:"🌎",category:"Monde 3D",html:"\u003c!DOCTYPE html>\n\u003chtml lang=\"fr\">\n\u003chead>\n\u003cmeta charset=\"UTF-8\">\n\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n\u003ctitle>Monde 3D réaliste\u003c/title>\n\u003cstyle>\n*{box-sizing:border-box}\nbody{margin:0;overflow:hidden;background:#9bd9ff;font-family:Arial;touch-action:none}\ncanvas{display:block}\nbutton{background:#20252bdd;color:white;border:2px solid #aaa;border-radius:10px;font-weight:bold;touch-action:none}\n#hud{position:fixed;top:8px;left:8px;background:#0009;color:white;padding:9px;border-radius:8px;font-size:12px;pointer-events:none}\n#inventory{position:fixed;top:8px;right:5px;display:flex;gap:3px}\n.slot{width:40px;height:43px;font-size:20px;padding:0}\n.selected{border:3px solid yellow}\n#controls{position:fixed;bottom:18px;left:10px;display:grid;grid-template-columns:52px 52px 52px;grid-template-rows:52px 52px;gap:4px}\n#up{grid-column:2}\n#left{grid-column:1;grid-row:2}\n#down{grid-column:2;grid-row:2}\n#right{grid-column:3;grid-row:2}\n#actions{position:fixed;bottom:18px;right:10px;display:flex;gap:5px}\n.action{width:60px;height:58px;font-size:12px}\n#jump{position:fixed;bottom:87px;right:17px;width:65px;height:48px}\n#hint{position:fixed;bottom:2px;left:50%;transform:translateX(-50%);background:#0008;color:white;padding:5px;border-radius:6px;font-size:10px;white-space:nowrap}\n\u003c/style>\n\u003cscript async src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9713764414342485\" crossorigin=\"anonymous\">\u003c/script>\n\u003c/head>\n\u003cbody>\n\n\u003cdiv id=\"hud\">🌍 Monde 3D\u003cbr>Chargement...\u003c/div>\n\n\u003cdiv id=\"inventory\">\n\u003cbutton class=\"slot selected\" data-type=\"grass\">🌿\u003c/button>\n\u003cbutton class=\"slot\" data-type=\"dirt\">🟫\u003c/button>\n\u003cbutton class=\"slot\" data-type=\"stone\">🪨\u003c/button>\n\u003cbutton class=\"slot\" data-type=\"wood\">🪵\u003c/button>\n\u003cbutton class=\"slot\" data-type=\"leaves\">🌳\u003c/button>\n\u003cbutton class=\"slot\" data-type=\"glass\">🔷\u003c/button>\n\u003c/div>\n\n\u003cdiv id=\"controls\">\n\u003cbutton id=\"up\">⬆️\u003c/button>\n\u003cbutton id=\"left\">⬅️\u003c/button>\n\u003cbutton id=\"down\">⬇️\u003c/button>\n\u003cbutton id=\"right\">➡️\u003c/button>\n\u003c/div>\n\n\u003cbutton id=\"jump\">SAUTER\u003c/button>\n\n\u003cdiv id=\"actions\">\n\u003cbutton class=\"action\" id=\"break\">⛏️\u003cbr>CASSER\u003c/button>\n\u003cbutton class=\"action\" id=\"place\">🧱\u003cbr>POSER\u003c/button>\n\u003c/div>\n\n\u003cdiv id=\"hint\">Glisse ton doigt au centre pour regarder autour de toi.\u003c/div>\n\n\u003cscript src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\">\u003c/script>\n\u003cscript>\nif(!window.THREE){\n document.body.innerHTML=\"Internet est nécessaire pour charger le jeu.\";\n throw new Error(\"Three.js indisponible\");\n}\n\n// MONDE ET LUMIÈRE\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color(0x91cbed);\nscene.fog=new THREE.Fog(0x91cbed,70,180);\n\nconst camera=new THREE.PerspectiveCamera(75,innerWidth/innerHeight,.1,500);\n\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.setPixelRatio(Math.min(devicePixelRatio,1.5));\nrenderer.outputEncoding=THREE.sRGBEncoding;\nrenderer.shadowMap.enabled=true;\nrenderer.shadowMap.type=THREE.PCFSoftShadowMap;\ndocument.body.appendChild(renderer.domElement);\n\nscene.add(new THREE.HemisphereLight(0xd7ecff,0x526044,1.7));\n\nconst sun=new THREE.DirectionalLight(0xfff0d6,2.1);\nsun.position.set(35,60,25);\nsun.castShadow=true;\nsun.shadow.mapSize.set(1024,1024);\nsun.shadow.camera.left=-35;\nsun.shadow.camera.right=35;\nsun.shadow.camera.top=35;\nsun.shadow.camera.bottom=-35;\nscene.add(sun);\n\n// TEXTURES PROCÉDURALES\nfunction texture(base,colors,count=700){\n const c=document.createElement(\"canvas\");\n c.width=c.height=64;\n const ctx=c.getContext(\"2d\");\n ctx.fillStyle=base;\n ctx.fillRect(0,0,64,64);\n\n for(let i=0;i\u003ccount;i++){\n  ctx.globalAlpha=.15+Math.random()*.35;\n  ctx.fillStyle=colors[Math.floor(Math.random()*colors.length)];\n  const x=Math.random()*64,y=Math.random()*64;\n  const s=1+Math.random()*4;\n  ctx.fillRect(x,y,s,s);\n }\n ctx.globalAlpha=1;\n\n const t=new THREE.CanvasTexture(c);\n t.magFilter=THREE.NearestFilter;\n t.minFilter=THREE.LinearMipmapLinearFilter;\n t.wrapS=t.wrapT=THREE.RepeatWrapping;\n return t;\n}\n\nfunction material(color,colors){\n return new THREE.MeshLambertMaterial({\n  map:texture(color,colors)\n });\n}\n\nconst grassTop=material(\"#579b36\",[\"#74b947\",\"#367b2b\",\"#8acb52\"]);\nconst dirt=material(\"#79502d\",[\"#654020\",\"#99683b\",\"#583b25\"]);\nconst stone=material(\"#858585\",[\"#a2a2a2\",\"#666666\",\"#777777\"]);\nconst wood=material(\"#80532d\",[\"#5d381c\",\"#a87943\",\"#70431f\"]);\nconst leaves=material(\"#317c30\",[\"#4c9b38\",\"#206326\",\"#75a84a\"]);\nconst roof=material(\"#974a35\",[\"#b35e42\",\"#743222\",\"#873b2b\"]);\n\nconst grassMat=[\n dirt,dirt,grassTop,dirt,dirt,dirt\n];\n\nconst glass=new THREE.MeshLambertMaterial({\n color:0x8bdcff,\n transparent:true,\n opacity:.48\n});\n\nconst materials={\n grass:grassMat,\n dirt:dirt,\n stone:stone,\n wood:wood,\n leaves:leaves,\n glass:glass,\n roof:roof\n};\n\nconst cube=new THREE.BoxGeometry(1,1,1);\nconst blocks=[];\nconst blockMap=new Map();\nconst chunks=new Set();\nconst villages=new Set();\nconst villagers=[];\n\nlet selected=\"grass\";\nlet yaw=0,pitch=0;\nlet verticalSpeed=0;\nlet grounded=false;\n\nconst PLAYER_RADIUS=.3;\nconst PLAYER_HEIGHT=1.8;\nconst EYE_HEIGHT=1.6;\n\nconst move={up:false,down:false,left:false,right:false};\nconst keys={};\nconst ray=new THREE.Raycaster();\nray.far=7;\n\nfunction key(x,y,z){\n return `${Math.round(x)},${Math.round(y)},${Math.round(z)}`;\n}\n\nfunction addBlock(x,y,z,type){\n x=Math.round(x);\n y=Math.round(y);\n z=Math.round(z);\n\n const k=key(x,y,z);\n if(blockMap.has(k))return null;\n\n const mesh=new THREE.Mesh(cube,materials[type]||grassMat);\n mesh.position.set(x,y,z);\n mesh.castShadow=true;\n mesh.receiveShadow=true;\n mesh.userData={x,y,z,type};\n\n scene.add(mesh);\n blocks.push(mesh);\n blockMap.set(k,mesh);\n return mesh;\n}\n\nfunction removeBlock(mesh){\n if(!mesh)return;\n\n const p=mesh.userData;\n blockMap.delete(key(p.x,p.y,p.z));\n scene.remove(mesh);\n\n const i=blocks.indexOf(mesh);\n if(i>=0)blocks.splice(i,1);\n}\n\nfunction terrainHeight(x,z){\n return Math.floor(\n  Math.sin(x*.085)*1.5+\n  Math.cos(z*.09)*1.4+\n  Math.sin((x+z)*.045)*1.7\n );\n}\n\n// COLLISIONS : LE JOUEUR NE TRAVERSE PAS LES BLOCS\nfunction collides(){\n const px=camera.position.x;\n const py=camera.position.y-EYE_HEIGHT;\n const pz=camera.position.z;\n\n const minX=Math.floor(px-PLAYER_RADIUS-.5);\n const maxX=Math.floor(px+PLAYER_RADIUS+.5);\n const minY=Math.floor(py-.5);\n const maxY=Math.floor(py+PLAYER_HEIGHT-.5);\n const minZ=Math.floor(pz-PLAYER_RADIUS-.5);\n const maxZ=Math.floor(pz+PLAYER_RADIUS+.5);\n\n for(let x=minX;x\u003c=maxX;x++){\n  for(let y=minY;y\u003c=maxY;y++){\n   for(let z=minZ;z\u003c=maxZ;z++){\n    if(!blockMap.has(key(x,y,z)))continue;\n\n    const overlapX=Math.abs(px-x)\u003cPLAYER_RADIUS+.5;\n    const overlapY=py\u003cy+.5 && py+PLAYER_HEIGHT>y-.5;\n    const overlapZ=Math.abs(pz-z)\u003cPLAYER_RADIUS+.5;\n\n    if(overlapX&&overlapY&&overlapZ)return true;\n   }\n  }\n }\n return false;\n}\n\nfunction makeTree(x,y,z){\n const h=3+Math.floor(Math.random()*3);\n\n for(let i=1;i\u003c=h;i++)addBlock(x,y+i,z,\"wood\");\n\n for(let dx=-2;dx\u003c=2;dx++){\n  for(let dz=-2;dz\u003c=2;dz++){\n   for(let dy=h-1;dy\u003c=h+2;dy++){\n    if(Math.abs(dx)+Math.abs(dz)+Math.abs(dy-h)\u003c=4){\n     addBlock(x+dx,y+dy,z+dz,\"leaves\");\n    }\n   }\n  }\n }\n}\n\nfunction makeHouse(x,z){\n const y=terrainHeight(x,z);\n\n for(let dx=0;dx\u003c5;dx++){\n  for(let dz=0;dz\u003c5;dz++){\n   addBlock(x+dx,y,z+dz,\"wood\");\n\n   for(let dy=1;dy\u003c=3;dy++){\n    const edge=dx===0||dx===4||dz===0||dz===4;\n    if(!edge)continue;\n\n    const door=dz===0&&dx===2&&dy\u003c=2;\n    const window=dy===2&&\n      ((dx===0&&dz===2)||(dx===4&&dz===2));\n\n    if(!door){\n     addBlock(x+dx,y+dy,z+dz,window?\"glass\":\"wood\");\n    }\n   }\n\n   addBlock(x+dx,y+4,z+dz,\"roof\");\n  }\n }\n}\n\nconst skin=new THREE.MeshLambertMaterial({color:0xb77c50});\nconst clothes=new THREE.MeshLambertMaterial({color:0x6654a1});\n\nfunction makeVillager(x,z){\n const y=terrainHeight(x,z)+1;\n const group=new THREE.Group();\n\n const body=new THREE.Mesh(\n  new THREE.BoxGeometry(.65,1,.45),clothes\n );\n body.position.y=.7;\n group.add(body);\n\n const head=new THREE.Mesh(\n  new THREE.BoxGeometry(.55,.55,.55),skin\n );\n head.position.y=1.5;\n group.add(head);\n\n group.position.set(x,y,z);\n scene.add(group);\n\n villagers.push({\n  group,x,z,\n  phase:Math.random()*6.28\n });\n}\n\nfunction makeVillage(x,z){\n const id=`${x},${z}`;\n if(villages.has(id))return;\n villages.add(id);\n\n makeHouse(x-7,z-5);\n makeHouse(x+2,z-5);\n makeHouse(x-3,z+5);\n\n for(let i=0;i\u003c6;i++){\n  makeVillager(\n   x+Math.floor(Math.random()*13)-6,\n   z+Math.floor(Math.random()*13)-6\n  );\n }\n}\n\n// MONDE QUI S'ÉTEND QUAND TU AVANCES\nfunction generateChunk(cx,cz){\n const id=`${cx},${cz}`;\n if(chunks.has(id))return;\n chunks.add(id);\n\n const size=12;\n const sx=cx*size,sz=cz*size;\n\n for(let x=sx;x\u003csx+size;x++){\n  for(let z=sz;z\u003csz+size;z++){\n   const h=terrainHeight(x,z);\n\n   addBlock(x,h,z,\"grass\");\n   addBlock(x,h-1,z,\"dirt\");\n   addBlock(x,h-2,z,\"dirt\");\n   addBlock(x,h-3,z,\"stone\");\n\n   if(Math.random()\u003c.025&&Math.abs(x)>7&&Math.abs(z)>7){\n    makeTree(x,h,z);\n   }\n  }\n }\n\n const vx=Math.round(cx/4)*48;\n const vz=Math.round(cz/4)*48;\n\n if(Math.abs(sx-vx)\u003csize&&Math.abs(sz-vz)\u003csize){\n  makeVillage(vx,vz);\n }\n}\n\nfunction generateWorld(){\n const cx=Math.floor(camera.position.x/12);\n const cz=Math.floor(camera.position.z/12);\n\n for(let x=cx-2;x\u003c=cx+2;x++){\n  for(let z=cz-2;z\u003c=cz+2;z++){\n   generateChunk(x,z);\n  }\n }\n}\n\n// DÉPART DIRECT DANS LE MONDE\ncamera.position.set(0,terrainHeight(0,8)+EYE_HEIGHT+.55,8);\ngenerateWorld();\n// Place le joueur exactement au-dessus du sol après génération du terrain.\nverticalSpeed=0;\ngrounded=true;\n\nfunction updateCamera(){\n camera.rotation.order=\"YXZ\";\n camera.rotation.y=yaw;\n camera.rotation.x=pitch;\n}\n\nfunction bindMove(id,name){\n const el=document.getElementById(id);\n\n el.addEventListener(\"pointerdown\",e=>{\n  e.preventDefault();\n  move[name]=true;\n });\n\n [\"pointerup\",\"pointercancel\",\"pointerleave\"].forEach(event=>{\n  el.addEventListener(event,()=>move[name]=false);\n });\n}\n\nbindMove(\"up\",\"up\");\nbindMove(\"down\",\"down\");\nbindMove(\"left\",\"left\");\nbindMove(\"right\",\"right\");\n\nfunction jump(){\n if(grounded){\n  verticalSpeed=8;\n  grounded=false;\n }\n}\n\ndocument.getElementById(\"jump\").addEventListener(\"pointerdown\",e=>{\n e.preventDefault();\n jump();\n});\n\naddEventListener(\"keydown\",e=>{\n keys[e.key.toLowerCase()]=true;\n if(e.code===\"Space\")jump();\n});\n\naddEventListener(\"keyup\",e=>{\n keys[e.key.toLowerCase()]=false;\n});\n\ndocument.querySelectorAll(\".slot\").forEach(button=>{\n button.addEventListener(\"click\",()=>{\n  document.querySelectorAll(\".slot\").forEach(b=>{\n   b.classList.remove(\"selected\");\n  });\n  button.classList.add(\"selected\");\n  selected=button.dataset.type;\n });\n});\n\nfunction findTarget(){\n ray.setFromCamera(new THREE.Vector2(0,0),camera);\n return ray.intersectObjects(blocks,false);\n}\n\ndocument.getElementById(\"break\").addEventListener(\"click\",()=>{\n const hits=findTarget();\n\n if(hits.length){\n  const p=hits[0].object.userData;\n\n  if(p.y>=terrainHeight(p.x,p.z)-2){\n   removeBlock(hits[0].object);\n  }\n }\n});\n\ndocument.getElementById(\"place\").addEventListener(\"click\",()=>{\n const hits=findTarget();\n if(!hits.length)return;\n\n const hit=hits[0];\n const normal=hit.face.normal.clone()\n  .transformDirection(hit.object.matrixWorld);\n\n const p=hit.object.position.clone().add(normal);\n if(p.distanceTo(camera.position)\u003c1.5)return;\n\n const newBlock=addBlock(p.x,p.y,p.z,selected);\n\n // Empêche de poser un bloc directement dans le joueur.\n if(newBlock&&collides()){\n  removeBlock(newBlock);\n }\n});\n\n// REGARD : SENSIBILITÉ AMÉLIORÉE\nlet looking=false,lastX=0,lastY=0;\n\nrenderer.domElement.addEventListener(\"pointerdown\",e=>{\n looking=true;\n lastX=e.clientX;\n lastY=e.clientY;\n});\n\naddEventListener(\"pointerup\",()=>looking=false);\naddEventListener(\"pointercancel\",()=>looking=false);\n\naddEventListener(\"pointermove\",e=>{\n if(!looking)return;\n\n yaw-=(e.clientX-lastX)*.009;\n pitch-=(e.clientY-lastY)*.009;\n\n pitch=Math.max(-1.45,Math.min(1.45,pitch));\n lastX=e.clientX;\n lastY=e.clientY;\n});\n\n// DÉPLACEMENT AVEC COLLISIONS FIABLES : sous-étapes pour ne pas traverser les blocs.\nfunction updatePlayer(dt){\n  const forward=new THREE.Vector3(-Math.sin(yaw),0,-Math.cos(yaw));\n  const side=new THREE.Vector3(Math.cos(yaw),0,-Math.sin(yaw));\n  const dir=new THREE.Vector3();\n  if(move.up||keys[\"w\"]||keys[\"arrowup\"])dir.add(forward);\n  if(move.down||keys[\"s\"]||keys[\"arrowdown\"])dir.sub(forward);\n  if(move.left||keys[\"a\"]||keys[\"arrowleft\"])dir.sub(side);\n  if(move.right||keys[\"d\"]||keys[\"arrowright\"])dir.add(side);\n\n  if(dir.lengthSq()>0){\n    dir.normalize().multiplyScalar(6*dt);\n    const steps=Math.max(1,Math.ceil(Math.max(Math.abs(dir.x),Math.abs(dir.z))/.08));\n    const sx=dir.x/steps, sz=dir.z/steps;\n    for(let i=0;i\u003csteps;i++){\n      camera.position.x+=sx;\n      if(collides())camera.position.x-=sx;\n      camera.position.z+=sz;\n      if(collides())camera.position.z-=sz;\n    }\n  }\n\n  // Gravité en petits pas : le joueur ne peut pas sauter au travers d'un bloc.\n  verticalSpeed=Math.max(verticalSpeed-20*dt,-18);\n  const dy=verticalSpeed*dt;\n  const stepsY=Math.max(1,Math.ceil(Math.abs(dy)/.06));\n  const sy=dy/stepsY;\n  grounded=false;\n  for(let i=0;i\u003cstepsY;i++){\n    camera.position.y+=sy;\n    if(collides()){\n      camera.position.y-=sy;\n      if(sy\u003c0)grounded=true;\n      verticalSpeed=0;\n      break;\n    }\n  }\n\n  // Sécurité au départ : si le personnage se trouve dans un bloc, le remonter au-dessus du sol.\n  if(collides()){\n    for(let i=0;i\u003c100&&collides();i++)camera.position.y+=.05;\n    verticalSpeed=0;\n    grounded=true;\n  }\n  generateWorld();\n}\n\nfunction updateVillagers(dt){\n for(const v of villagers){\n  v.phase+=dt*.7;\n  v.group.position.x=v.x+Math.sin(v.phase)*1.5;\n  v.group.position.z=v.z+Math.cos(v.phase*.7)*1.5;\n }\n}\n\nconst clock=new THREE.Clock();\n\nfunction animate(){\n requestAnimationFrame(animate);\n\n const dt=Math.min(clock.getDelta(),.035);\n\n updatePlayer(dt);\n updateVillagers(dt);\n updateCamera();\n\n document.getElementById(\"hud\").innerHTML=\n  \"🌍 Monde 3D\"+\n  \"\u003cbr>Position : \"+\n  Math.floor(camera.position.x)+\", \"+\n  Math.floor(camera.position.z)+\n  \"\u003cbr>Blocs : \"+blocks.length+\n  \"\u003cbr>Villages : \"+villages.size+\n  \"\u003cbr>Bloc : \"+selected;\n\n renderer.render(scene,camera);\n}\n\nanimate();\n\naddEventListener(\"resize\",()=>{\n camera.aspect=innerWidth/innerHeight;\n camera.updateProjectionMatrix();\n renderer.setSize(innerWidth,innerHeight);\n});\n\u003c/script>\n\u003c/body>\n\u003c/html>"}
];

const menu=document.getElementById('menu');
games.forEach((g,i)=>{
const card=document.createElement('article');
card.className='card';
const icon=document.createElement('div');icon.className='icon';icon.textContent=g.icon;
const title=document.createElement('h2');title.textContent=g.title;
const category=document.createElement('div');category.className='small';category.textContent=g.category;
const button=document.createElement('button');button.textContent='Jouer';button.onclick=()=>openGame(i);
card.append(icon,title,category,button);menu.appendChild(card);
});

function openGame(i){
const g=games[i];
document.getElementById('gameTitle').textContent=g.title;
const frame=document.getElementById('frame');
frame.srcdoc=g.html;
document.getElementById('player').style.display='block';
}
document.getElementById('back').onclick=()=>{
document.getElementById('frame').src='about:blank';
document.getElementById('player').style.display='none';
};
document.getElementById('full').onclick=()=>{
const p=document.getElementById('player');
if(p.requestFullscreen)p.requestFullscreen();
};

let connected=false;
const status=document.getElementById('status');
document.getElementById('authForm').onsubmit=e=>{
e.preventDefault();
status.textContent='La connexion réelle par e-mail nécessite un service sécurisé.';
};
document.getElementById('register').onclick=()=>{
status.textContent='Pour créer un vrai compte, connecte ce site à un service d’authentification.';
};
document.getElementById('logout').onclick=()=>{
connected=false;
status.textContent='Déconnecté.';
};

document.getElementById('createRoom').onclick=()=>{
const name=document.getElementById('room').value.trim();
document.getElementById('roomStatus').textContent=name?
'Salon demandé : '+name+'. Il faut un serveur multijoueur pour le rendre accessible aux autres joueurs.':
'Choisis un nom de salon.';
};
document.getElementById('joinRoom').onclick=()=>{
const name=document.getElementById('room').value.trim();
document.getElementById('roomStatus').textContent=name?
'Tentative de rejoindre : '+name+'. Le serveur multijoueur doit encore être configuré.':
'Entre le nom du salon à rejoindre.';
};
</script>
</body>
</html>
