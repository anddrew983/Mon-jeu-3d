title:"Drift Boss",icon:"🏎️",category:"Voiture",
html:`<!doctype html><html lang="fr"><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{text-align:center;background:#14271e;color:white;font-family:Arial;margin:0}canvas{width:100%;max-width:500px}button{padding:13px}</style><h2>🏎️ Drift Boss</h2><canvas id="c" width="500" height="600"></canvas><p><button id="t">MAINTENIR POUR TOURNER</button> <button onclick="restart()">RECOMMENCER</button></p><script>let c=document.getElementById('c'),x=c.getContext('2d'),px=250,py=510,s=0,alive=true,turn=false;function draw(){x.fillStyle='#18432b';x.fillRect(0,0,500,600);x.fillStyle='#666';x.fillRect(145,0,210,600);x.strokeStyle='white';x.setLineDash([25,22]);x.beginPath();x.moveTo(250,0);x.lineTo(250,600);x.stroke();x.setLineDash([]);if(alive){px+=turn?2.8:-1.2;py-=1.4;s++;if(px<155||px>345||py<15)alive=false;x.fillStyle='red';x.fillRect(px-14,py-22,28,44);x.fillStyle='white';x.fillText('Score : '+Math.floor(s/10),15,30);requestAnimationFrame(draw)}else{x.fillStyle='white';x.font='26px Arial';x.fillText('Partie terminée',155,300)}}document.getElementById('t').onpointerdown=e=>{turn=true;e.currentTarget.setPointerCapture(e.pointerId)};document.getElementById('t').onpointerup=()=>turn=false;document.getElementById('t').onpointercancel=()=>turn=false;function restart(){px=250;py=510;s=0;alive=true;draw()}draw();<\/script></html>`
