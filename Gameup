<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b1020">
<title>Game Up 3D</title>

<style>
*{box-sizing:border-box}
body{margin:0;background:#0b1020;color:white;font-family:Arial,sans-serif}
header{text-align:center;padding:22px 10px;background:linear-gradient(135deg,#172b50,#101525)}
h1{margin:0;color:#5be7ff;font-size:clamp(28px,6vw,48px)}
header p{color:#cbd5e1}
button,input{font:inherit}
button{cursor:pointer;border:0;border-radius:10px;padding:12px 17px;font-weight:bold;background:#39d9f5;color:#071321}
button:active{transform:scale(.97)}
#account{max-width:420px;margin:20px auto;padding:20px;background:#172139;border-radius:16px}
#account input{width:100%;padding:13px;margin:6px 0;border-radius:8px;border:1px solid #455574;background:#0b1020;color:white}
#account button{width:100%;margin-top:8px}
#account p{font-size:13px;color:#bdc9dc}
#status{text-align:center;color:#70f5b1}
#menu{max-width:1200px;margin:auto;padding:15px;display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:15px}
.card{background:linear-gradient(145deg,#202e4c,#141b2e);border:1px solid #344766;border-radius:16px;padding:18px 10px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:190px}
.card .icon{font-size:48px}
.card h2{font-size:17px}
.card button{margin-top:8px}
#multiplayer{margin:10px auto 25px;max-width:600px;padding:20px;background:#172139;border-radius:16px;text-align:center}
#multiplayer input{width:100%;padding:12px;margin:7px 0;background:#0b1020;border:1px solid #455574;border-radius:8px;color:white}
#player{display:none;position:fixed;inset:0;background:#080b13;z-index:10}
#bar{height:55px;display:flex;justify-content:space-between;align-items:center;gap:8px;padding:7px;background:#172139}
#bar button{padding:9px}
#frame{width:100%;height:calc(100dvh - 55px);border:0;background:white}
.hidden{display:none!important}
.small{font-size:13px;color:#bdc9dc;line-height:1.5}
@media(max-width:480px){
 #menu{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:10px}
 .card{min-height:165px;padding:12px 6px}
 .card .icon{font-size:40px}
 .card h2{font-size:14px}
 #bar strong{display:none}
}
</style>

<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9713764414342485" crossorigin="anonymous"></script>
</head>

<body>

<header>
<h1>🎮 GAME UP 3D</h1>
<p>Tes jeux, ton monde, tes amis !</p>
</header>

<section id="account">
<h2>👤 Compte joueur</h2>
<p class="small">Crée un compte ou connecte-toi pour préparer ton profil.</p>

<form id="authForm">
<input id="email" type="email" placeholder="Adresse e-mail" required autocomplete="email">
<input id="password" type="password" placeholder="Mot de passe" required minlength="8" autocomplete="current-password">
<button type="submit">Se connecter</button>
</form>

<button id="register" type="button">Créer un compte</button>
<button id="logout" type="button" class="hidden">Se déconnecter</button>
<p id="status">Aucun compte connecté.</p>
<p class="small">
Important : cette version ne stocke pas de vrais comptes en ligne.
Pour une connexion sécurisée par e-mail, il faut connecter un service d'authentification.
</p>
</section>

<main id="menu"></main>

<section id="multiplayer">
<h2>🌐 Multijoueur</h2>
<p>Prépare un salon pour jouer avec tes amis.</p>
<input id="room" maxlength="24" placeholder="Nom du salon (ex. amis123)">
<button id="createRoom">Créer un salon</button>
<button id="joinRoom">Rejoindre un salon</button>
<p id="roomStatus" class="small">
Le multijoueur réel nécessite un serveur partagé. Ce formulaire ne connecte pas encore les joueurs.
</p>
</section>

<section id="player">
<div id="bar">
<button id="back">← Menu</button>
<strong id="gameTitle">Jeu</strong>
<button id="full">⛶ Plein écran</button>
</div>
<iframe id="frame" title="Jeu sélectionné"
allow="fullscreen; autoplay; gamepad; accelerometer; gyroscope"
sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock allow-popups"></iframe>
</section>

<script>
const games=[
{
title:"T-Rex Runner",icon:"🦖",category:"Arcade",
html:"\u003c!doctype html>\n\u003chtml lang=\"fr\">\n\u003chead>\n\u003cmeta charset=\"utf-8\">\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n\u003ctitle>Game Up 3D — T-Rex Runner\u003c/title>\n\u003cstyle>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:system-ui,Arial;background:#eaf6ff;touch-action:manipulation}canvas{display:block;width:100%;height:100%;touch-action:manipulation}button{font:700 16px system-ui;border:0;border-radius:12px;padding:12px 14px;cursor:pointer}#fullscreen{position:fixed;top:12px;right:12px;z-index:3;background:#20282d;color:#fff}#help{position:fixed;top:14px;left:12px;background:#ffffffd9;padding:8px 10px;border-radius:10px;font-size:14px;color:#20282d}#overlay{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:#10202a66;z-index:4}#panel{background:white;text-align:center;padding:24px;border-radius:18px;width:min(88vw,360px);box-shadow:0 12px 35px #0003}#panel h1{margin:0 0 10px}#restart{background:#1877e8;color:white}\n\u003c/style>\n\u003c/head>\u003cbody>\n\u003cdiv id=\"help\">Touche l’écran pour sauter\u003c/div>\u003cbutton id=\"fullscreen\">⛶ Plein écran\u003c/button>\u003ccanvas id=\"game\" aria-label=\"T-Rex Runner\">\u003c/canvas>\n\u003cdiv id=\"overlay\">\u003cdiv id=\"panel\">\u003ch1>Oups !\u003c/h1>\u003cp id=\"scoreEnd\">Score : 0\u003c/p>\u003cp id=\"recordEnd\">Record : 0\u003c/p>\u003cbutton id=\"restart\">Rejouer\u003c/button>\u003c/div>\u003c/div>\n\u003cscript>\n(()=>{\nconst canvas=document.querySelector('#game'),ctx=canvas.getContext('2d'),overlay=document.querySelector('#overlay');let W=0,H=0,dpr=1,ground=0,player,obstacles,clouds,score=0,record=0,speed=6,alive=true,last=0,spawn=0,world=0;\ntry{record=Number(localStorage.getItem('gameup_trex_record')||0)}catch(e){}\nfunction resize(){dpr=Math.min(devicePixelRatio||1,2);W=innerWidth;H=innerHeight;canvas.width=Math.floor(W*dpr);canvas.height=Math.floor(H*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);ground=H*.79;if(!player)reset();else if(!player.jump)player.y=ground-player.h;draw()}\nfunction reset(){player={x:Math.max(28,W*.12),y:ground-48,w:42,h:48,vy:0,jump:false,leg:0};obstacles=[];clouds=[{x:W*.22,y:H*.18,s:1},{x:W*.62,y:H*.12,s:.75},{x:W*.88,y:H*.24,s:.9}];score=0;speed=Math.max(5,W*.0055);spawn=0;world=0;alive=true;overlay.style.display='none';last=0;draw()}\nfunction jump(){if(alive&&!player.jump){player.vy=-Math.max(11,H*.018);player.jump=true}}\nfunction end(){alive=false;record=Math.max(record,Math.floor(score));try{localStorage.setItem('gameup_trex_record',record)}catch(e){}document.querySelector('#scoreEnd').textContent='Score : '+Math.floor(score);document.querySelector('#recordEnd').textContent='Record : '+record;overlay.style.display='flex'}\nfunction dino(){let p=player,x=p.x,y=p.y;ctx.fillStyle='#29343a';ctx.fillRect(x+7,y+15,27,28);ctx.fillRect(x+22,y+2,21,22);ctx.fillRect(x+31,y+12,15,7);ctx.fillRect(x,y+23,11,7);ctx.fillStyle='#fff';ctx.fillRect(x+35,y+7,4,4);ctx.fillStyle='#29343a';if(!p.jump&&Math.floor(p.leg)%2===0){ctx.fillRect(x+10,y+40,8,8);ctx.fillRect(x+27,y+40,8,5)}else{ctx.fillRect(x+12,y+40,6,5);ctx.fillRect(x+25,y+40,8,8)}}\nfunction cactus(o){ctx.fillStyle='#25834b';ctx.fillRect(o.x+o.w*.38,o.y,o.w*.28,o.h);ctx.fillRect(o.x,o.y+o.h*.38,o.w*.48,o.h*.14);ctx.fillRect(o.x,o.y+o.h*.25,o.w*.15,o.h*.3);ctx.fillRect(o.x+o.w*.58,o.y+o.h*.53,o.w*.42,o.h*.14);ctx.fillRect(o.x+o.w*.83,o.y+o.h*.34,o.w*.15,o.h*.34)}\nfunction draw(){if(!W||!H)return;let g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#dff3ff');g.addColorStop(.70,'#f7fbff');g.addColorStop(.70,'#f1f0e8');g.addColorStop(1,'#e5e5dc');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);ctx.fillStyle='#ffd66b';ctx.beginPath();ctx.arc(W*.82,H*.17,Math.min(28,W*.045),0,Math.PI*2);ctx.fill();for(let c of clouds){ctx.fillStyle='white';ctx.beginPath();ctx.arc(c.x,c.y,14*c.s,0,7);ctx.arc(c.x+17*c.s,c.y-6*c.s,18*c.s,0,7);ctx.arc(c.x+34*c.s,c.y,13*c.s,0,7);ctx.fill()}ctx.strokeStyle='#59656a';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(0,ground);ctx.lineTo(W,ground);ctx.stroke();ctx.strokeStyle='#b8b8ad';ctx.lineWidth=2;for(let x=-(world%48);x\u003cW;x+=48){ctx.beginPath();ctx.moveTo(x,ground+17);ctx.lineTo(x+23,ground+17);ctx.stroke()}if(player)dino();for(let o of obstacles)cactus(o);ctx.fillStyle='#20282d';ctx.font='bold 21px system-ui';ctx.textAlign='right';ctx.fillText('Score : '+Math.floor(score),W-18,H>450?75:48);ctx.textAlign='left';ctx.font='bold 14px system-ui';ctx.fillText('Record : '+record,14,H>450?80:48)}\nfunction update(dt){if(!alive)return;let s=Math.min(dt/16.67,2.3);world+=speed*s;score+=s*.16;speed+=s*.001;player.leg+=s;player.y+=player.vy*s;player.vy+=.62*s;if(player.y>=ground-player.h){player.y=ground-player.h;player.vy=0;player.jump=false}spawn-=s;if(spawn\u003c=0){let hh=30+Math.random()*25,ww=18+Math.random()*12;obstacles.push({x:W+20,y:ground-hh,w:ww,h:hh});spawn=52+Math.random()*42}for(let o of obstacles)o.x-=speed*s;obstacles=obstacles.filter(o=>o.x+o.w>-10);for(let o of obstacles){if(player.x+player.w-7>o.x+3&&player.x+7\u003co.x+o.w-3&&player.y+player.h-5>o.y+3){end();break}}for(let c of clouds){c.x-=speed*.12*s;if(c.x\u003c-70)c.x=W+40}}\nfunction loop(t){if(!last)last=t;let dt=t-last;last=t;update(dt);draw();requestAnimationFrame(loop)}\ncanvas.addEventListener('pointerdown',e=>{e.preventDefault();jump()});document.addEventListener('keydown',e=>{if(e.code==='Space'||e.code==='ArrowUp'){e.preventDefault();jump()}});document.querySelector('#restart').addEventListener('click',reset);document.querySelector('#fullscreen').addEventListener('click',async()=>{try{if(!document.fullscreenElement)await document.documentElement.requestFullscreen();else await document.exitFullscreen()}catch(e){alert('Le plein écran n’est pas autorisé par ce navigateur. Essaie d’ouvrir la page dans Chrome.') }});addEventListener('resize',resize);resize();requestAnimationFrame(loop)\n})();\n\u003c/script>\u003c/body>\u003c/html>\n"
